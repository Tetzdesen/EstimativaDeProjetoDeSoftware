# CONFIGURAÇÃO SQLite

# Tipo de banco de dados utilizado
TIPO_BANCO = "SQLite"

# URL de conexão com o banco de dados SQLite (modo arquivo)
DB_URL = jdbc:sqlite:db/database.db

# Classe de fábrica dos repositórios para o banco escolhido em TIPO_BANCO.
# A chave abaixo precisa ter exatamente o mesmo nome do valor de TIPO_BANCO.
SQLite = "com.br.estimativadeprojetodesoftware.abstractfactory.FabricaRepositorySQLite"

# Credenciais do banco. O SQLite em modo arquivo não usa nenhuma delas;
# descomente apenas se trocar para um banco que exija autenticação.
# DB_USER =
# DB_PASSWORD =
# DB_DRIVER =
