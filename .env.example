# CONFIGURAÇÃO DO BANCO DE DADOS
#
# Para trocar de banco, altere apenas TIPO_BANCO e DB_URL.
# O valor de TIPO_BANCO precisa ter uma chave de mesmo nome logo abaixo,
# apontando para a fábrica de repositórios daquele banco.

# Tipo de banco de dados utilizado: "SQLite", "H2" ou "Postgres"
TIPO_BANCO = "SQLite"

# URL de conexão
# SQLite (arquivo):
DB_URL = jdbc:sqlite:db/database.db
# H2 (arquivo embutido, sem servidor):
# DB_URL = jdbc:h2:./db/estimativa
# PostgreSQL remoto (ex.: Supabase, pooler de sessão; o host aparece em Connect → Session pooler,
# algo como aws-N-<região>.pooler.supabase.com). SSL com verificação do
# certificado é obrigatório: sslmode=verify-full e sslrootcert apontando para o
# certificado da autoridade, baixado do painel do Supabase (fica em db/certs/).
# DB_URL = jdbc:postgresql://<host do pooler de sessão>:5432/postgres?currentSchema=estimativa&sslmode=verify-full&sslrootcert=db/certs/prod-ca-2021.crt

# Fábricas de repositórios por banco
SQLite = "com.br.estimativadeprojetodesoftware.abstractfactory.FabricaRepositorySQLite"
H2 = "com.br.estimativadeprojetodesoftware.abstractfactory.FabricaRepositoryH2"
Postgres = "com.br.estimativadeprojetodesoftware.abstractfactory.FabricaRepositoryPostgres"

# Credenciais do banco. SQLite e H2 embutido não precisam delas.
# No Supabase, use o papel exclusivo do sistema (veja docs/supabase/configurar.sql);
# pelo pooler, o usuário leva a referência do projeto: estimativa_app.<referência>.
# Nunca coloque senhas reais neste arquivo de exemplo.
# DB_USER = estimativa_app.<referência-do-projeto>
# DB_PASSWORD = <senha do papel estimativa_app>

# Arquivo de log (sem extensão; o formato CSV ou JSON é escolhido na tela de Configuração)
LOG_ARQUIVO = logs/estimativa
