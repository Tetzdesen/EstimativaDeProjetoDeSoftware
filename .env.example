# CONFIGURAÇÃO DO BANCO DE DADOS
#
# Para trocar de banco, altere apenas TIPO_BANCO e DB_URL.
# O valor de TIPO_BANCO precisa ter uma chave de mesmo nome logo abaixo,
# apontando para a fábrica de repositórios daquele banco.

# Tipo de banco de dados utilizado: "SQLite" ou "H2"
TIPO_BANCO = "SQLite"

# URL de conexão
# SQLite (arquivo):
DB_URL = jdbc:sqlite:db/database.db
# H2 (arquivo embutido, sem servidor):
# DB_URL = jdbc:h2:./db/estimativa

# Fábricas de repositórios por banco
SQLite = "com.br.estimativadeprojetodesoftware.abstractfactory.FabricaRepositorySQLite"
H2 = "com.br.estimativadeprojetodesoftware.abstractfactory.FabricaRepositoryH2"

# Credenciais do banco. SQLite e H2 embutido não precisam delas.
# DB_USER =
# DB_PASSWORD =

# Arquivo de log (sem extensão; o formato CSV ou JSON é escolhido na tela de Configuração)
LOG_ARQUIVO = logs/estimativa
